# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evolve_church

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — Google sign-in is disabled when unset)
# In Google Cloud Console → Credentials → OAuth client:
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@evolvechms.org
# Comma-separated inboxes for landing demo / interest leads
OWNER_NOTIFY_EMAIL=owners@evolvechms.org


# SMS (Twilio — optional; demo stub used when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Local demo: skip auth middleware when true
AUTH_DISABLED=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AUTH_DISABLED=false
